{
  "paths": {
    "processed_data_path": "dataset/processed/data_paths.npz",
    "encoder_path": "saved_models/label_encoder.joblib",
    "noise_source_dir": "dataset/raw/tellonoise",
    "model_dir": "saved_models/weekly_drone_2026w15/stats_laux_a020_reuse_strict",
    "result_dir": "result/weekly_drone_2026w15/stats_laux_a020_reuse_strict",
    "history_dir": "result/weekly_drone_2026w15/stats_laux_a020_reuse_strict/history",
    "teacher_ckpt": "saved_models/weekly_drone_2026w15/newarch_teacher_anchor/teacher_clean_best.weights.h5",
    "student_ckpt": "saved_models/weekly_drone_2026w15/stats_laux_a020_reuse_strict/student_kd_best.weights.h5"
  },
  "train": {
    "batch_size": 32,
    "teacher_epochs": 50,
    "student_epochs": 50,
    "learning_rate": 0.0001,
    "reuse_teacher": true,
    "strict_reuse_teacher_shape": true,
    "random_seed": 42,
    "teacher_model_profile": "base",
    "student_model_profile": "base",
    "student_init_mode": "auto",
    "student_init_ckpt": null,
    "earlystop_patience": 10,
    "teacher_monitor": "val_accuracy",
    "student_monitor": "val_accuracy"
  },
  "stats_branch": {
    "teacher": {
      "use_stats_branch": true,
      "stats_dim": 4,
      "stats_mlp_units": [
        32,
        16
      ],
      "fuse_units": 128,
      "fusion_mode": "concat",
      "gate_units": 16
    },
    "student": {
      "use_stats_branch": true,
      "stats_dim": 4,
      "stats_mlp_units": [
        32,
        16
      ],
      "fuse_units": 128,
      "fusion_mode": "concat",
      "gate_units": 16
    },
    "pitch_fmin": 50.0,
    "pitch_fmax": 500.0
  },
  "noise": {
    "noise_mix_prob": 1.0,
    "min_snr_db": -15.0,
    "max_snr_db": -5.0,
    "eval_snr_db": -10.0
  },
  "prosody": {
    "enable_class_prosody_aug": true,
    "teacher_enable_prosody_aug": false,
    "student_enable_prosody_aug": true,
    "emergency_class_name": "emergency",
    "emergency_prob": 1.0,
    "emergency_pitch_min": 2.0,
    "emergency_pitch_max": 5.0,
    "emergency_gain_db_min": 6.0,
    "emergency_gain_db_max": 10.0,
    "non_emergency_prob": 0.0,
    "non_emergency_pitch_min": 0.0,
    "non_emergency_pitch_max": 0.0,
    "non_emergency_gain_db_min": 0.0,
    "non_emergency_gain_db_max": 0.0
  },
  "distillation": {
    "variant": "embed_only",
    "alpha_ce": 1.0,
    "logits_beta": 1.0,
    "embed_gamma_max": 1.0,
    "temperature": 2.0,
    "use_embed_projection": true,
    "embed_warmup_epochs": 15,
    "embed_ramp_epochs": 35
  },
  "aux_loss": {
    "aux_alpha": 0.2,
    "aux_mode": "embed_align",
    "aux_loss_type": "huber"
  },
  "prewarm": {
    "prewarm_epochs": 0,
    "prewarm_lr": 0.0001,
    "prewarm_alpha_ce": 1.0,
    "prewarm_logits_beta": 1.0,
    "prewarm_temperature": 2.0,
    "prewarm_use_ce": true,
    "prewarm_use_logits": true,
    "prewarm_enable_prosody_aug": false,
    "prewarm_patience": 5,
    "prewarm_monitor": "val_accuracy"
  }
}